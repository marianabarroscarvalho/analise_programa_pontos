# Copie para .env (ignorado pelo git) e ajuste os valores.
GCP_PROJECT_ID=stoked-outlook-303718
# Aceita "dataset" ou "projeto.dataset"
BIGQUERY_DATASET_ID=stoked-outlook-303718.brain003
# Caminho para a chave JSON da service account ingestao-brain003@stoked-outlook-303718.iam.gserviceaccount.com
GOOGLE_APPLICATION_CREDENTIALS=./stoked-outlook-303718-8ef2bcb2a624.json
CSV_FOLDER_PATH=./dados
# WRITE_TRUNCATE (sobrescreve) ou WRITE_APPEND (incrementa)
WRITE_DISPOSITION=WRITE_TRUNCATE
# Opcional: location usada apenas se o dataset ainda não existir
BIGQUERY_LOCATION=US
